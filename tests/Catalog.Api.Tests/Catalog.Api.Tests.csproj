<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing: the runner is compiled in
         rather than loaded by a host, so the assembly has to be an Exe. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <!-- The endpoints gate (§4.2) — a namespace rule, so it needs type-level
         dependency analysis rather than GetReferencedAssemblies. -->
    <PackageReference Include="NetArchTest.Rules" />
    <!-- WebApplicationFactory over the real Program (§12.4). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Real SQL Server, per ADR-010: the in-memory provider enforces no
         foreign keys, implements no rowversion and translates LINQ
         differently, so a suite green against it still fails in production. -->
    <PackageReference Include="Testcontainers.MsSql" />
    <!-- SqlServerRetryingExecutionStrategy, for the subclass that lets the
         retry test inject a fault the strategy treats as transient. Already
         pinned centrally and in Appendix B via Catalog.Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\Catalog\Catalog.Api\Catalog.Api.csproj" />
    <!-- The migrator, because its exit code is a contract with §7.4's
         `backoffLimit: 2` and the smoke drives the real host rather than a
         copy of its wiring. §4.1 gives the service three test projects and
         none of them is a *.Migrator.Tests, so the suite that owns containers
         owns this too. -->
    <ProjectReference Include="..\..\src\Services\Catalog\Catalog.Migrator\Catalog.Migrator.csproj" />
  </ItemGroup>

</Project>
