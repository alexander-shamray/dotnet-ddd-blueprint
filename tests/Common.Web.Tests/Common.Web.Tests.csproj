<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing: the runner is compiled in
         rather than loaded by a host, so the assembly has to be an Exe. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <!-- The real middleware pipeline, in memory. UseCorrelationId, the
         ProblemDetails customisation and ToHttpResult are three pieces that
         only fail together: a customiser that never runs on what ToHttpResult
         writes is invisible to any test that inspects the IResult alone. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- Reads log records and metrics back out of a real OpenTelemetry
         pipeline, so the redactor and the meter list are asserted through the
         path a host actually uses rather than through a stub. -->
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <!-- JwtBearerDefaults and JwtBearerOptions, read back to pin §11.3's
         validation parameters. Carried transitively by the project reference
         below; named here because this assembly uses the types directly, on
         the register's honesty rule. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\Common.Web\Common.Web.csproj" />
  </ItemGroup>

</Project>
