root = true

# House style for .NET 10 and C# 14. This governs both the C# samples in
# docs/backend-architecture/ and the solution that will be built in src/ and
# tests/ — one dialect, so a sample and its implementation read identically.
# CLAUDE.md carries the prose version, including the settled choices a reviewer
# might otherwise try to "correct".
#
# This is the .editorconfig delivery-plan PR-01 ships. Treat it as source.
#
# PR-01 also sets EnforceCodeStyleInBuild (ADR-019), which promotes this file
# from an editor convenience to a build input — but only for rules configured
# at `warning` or above. A rule left at `suggestion` or `silent` is documented
# here and enforced by nothing.
#
# Three are at warning: IDE0055 (formatting), IDE0065 (using placement) and
# IDE0161 (file-scoped namespaces). Each is stated without exception in
# CLAUDE.md, so a violation is always a defect. Everything else stays a
# suggestion on purpose — the `var` rules below carry a documented exception
# Roslyn cannot express, and a rule whose carve-out lives in prose must not
# fail a build it cannot evaluate.

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
indent_size = 2
# No max_line_length: prose wraps at 80 (see CLAUDE.md), but tables, links and
# fenced code legitimately run past it — hundreds of lines in the blueprint do,
# and a hard limit here would flag every one of them.

[*.{json,yml,yaml}]
indent_size = 2

[*.{cs,csx}]
indent_size = 4
tab_width = 4

# The budget a list has before it must break. Unlike [*.md] above, a number is
# worth setting here: it is the threshold the wrapping rule turns on, so an
# editor ruler at 120 shows the same boundary the rule is written against.
#
# Roslyn will not enforce the rule. There is no wrapping engine — no setting
# reflows a list to fit, or breaks one that does not, so `dotnet format` leaves
# both alone. Like csharp_prefer_braces below, this value is a declaration and
# CLAUDE.md carries the rule itself.
#
# csharp_new_line_before_open_brace is deliberately NOT set. Its categories are
# all-or-nothing: naming `lambdas` would be right for the block-bodied ones the
# corpus writes Allman, and wrong for `o => { /* §11.3 */ }`; naming
# `object_collection_array_initializers` would explode every short `new { … }`
# the one-line rule exists to keep. The C# default already matches the dominant
# style, and the short forms are the wrapping rule's job, not a formatter's.
max_line_length = 120

# --- Wrapping: what a formatter must not undo ---
# The rules above are declarative, but three of `dotnet format`'s defaults would
# actively rewrite code that already follows them. These three are not
# preferences; they are the settings that keep a format run idempotent.

# The braceless body goes on the line AFTER its condition, never beside it —
# 53 sites, and the rule that makes csharp_prefer_braces = false readable.
# Left at the default (true), a formatter would pull `app.UseCors();` back up
# onto its `if (corsEnabled)` line and undo the distinction.
csharp_preserve_single_line_statements = false

# ...but a one-line BLOCK stays one line: `{ get; init; }` on 85 members, and
# `o => { /* §11.3 */ }` where the elision is the point.
csharp_preserve_single_line_blocks = true

# Extra spaces before `=` are alignment, not accident: 78 declarations and
# initialiser members line their values up in a column (§8.2's HybridCache
# options, §6.6's anonymous parameter objects). `false` here would collapse
# every one of them to a single space.
csharp_space_around_declaration_statements = ignore

# Members of a multi-line initialiser get one line each — the list rule, in the
# one place Roslyn can state it. Stated rather than inherited, because
# csharp_preserve_single_line_blocks above is what keeps `new { q.ProductId }`
# and `new { MaxAttempts }` from being exploded by it, and the two are only
# legible as a pair.
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# No setting expresses these; CLAUDE.md carries them and a reviewer should not
# go looking for a key that does not exist:
#   - `=>` trails the signature of an expression-bodied member, with the body
#     at the DECLARATION's indent + 4 (not the `=>` line's).
#   - A broken fluent chain puts every call on its own line, first one included.
#   - A break goes at the outermost bracket, never a nested one.
#   - A wrapped condition takes braces on its body.
# dotnet_style_operator_placement_when_wrapping (below, in [*.cs]) is the
# closest thing to enforcement, and it governs binary operators only — not `=>`.

# There is deliberately NO [*.sql] section, and adding one would be a mistake
# rather than an omission. §7.4 is normative: hand-written DDL ships inside a
# migration's `migrationBuilder.Sql("""…""")`, and "there is no second
# mechanism" — so the solution has no .sql files for a section to match.
#
# That puts every statement inside a C# raw string literal, which no formatter
# reads or rewrites. The SQL conventions in CLAUDE.md are therefore both
# unenforceable and unbreakable by tooling: `dotnet format` will not fix a
# keyword river and will not introduce one. They are a review rule, and the
# only one in this file's remit that is.

# --- .NET / C# style ---
# At warning, so EnforceCodeStyleInBuild fails on it. CLAUDE.md states this one
# without exception and notes it binds source only — the samples carry no using
# directives at all, so there is nothing here for the rule to argue with.
csharp_using_directive_placement = outside_namespace:warning
csharp_space_around_binary_operators = before_and_after
csharp_indent_labels = one_less_than_current
csharp_prefer_simple_using_statement = true:suggestion
csharp_prefer_simple_default_expression = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_unused_value_assignment_preference = discard_variable:suggestion
csharp_preferred_modifier_order = public, private, protected, internal, file, new, static, abstract, virtual, sealed, readonly, override, extern, unsafe, volatile, async, required:suggestion

# Explicit types, except where the right-hand side already names the type.
# `var order = new Order(...)` is fine; `var rows = await conn.QueryAsync(...)`
# is not — a reader of a fenced code block has no hover to fall back on.
#
# CLAUDE.md lists four cases that keep `var`. Three need nothing here: an
# apparent type is `when_type_is_apparent` below, deconstruction is
# `deconstructed_variable_declaration`, and anonymous types make `var`
# mandatory in the language. The fourth is the Aspire AppHost of §14.2, where
# eleven of thirteen locals are an IResourceBuilder<T> — a wrapper whose name
# repeats what the Add* call already said. Explicit types are possible there and
# simply read worse, so the block stays uniform. That preference cannot be
# expressed as a setting, which is why these stay at suggestion, not warning.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_deconstructed_variable_declaration = true:suggestion

# --- Settled choices ---
# House style a reviewer might read as an oversight and "correct". They bind the
# solution as much as the samples; changing one is a decision about the whole
# corpus. CLAUDE.md tabulates four — the three expressible ones below, plus the
# .NET 10 / C# 14 target, which is a csproj concern rather than a style setting.

# A single statement may omit braces, and 53 sites in the blueprint do. Roslyn
# cannot express "one statement, wrapped or not", so this value is declarative
# only — hence silent, with CLAUDE.md carrying the real rule.
csharp_prefer_braces = false:silent

# At warning for the same reason: "file-scoped, never block-scoped" is one of
# the four settled choices, with no case in the corpus going the other way.
csharp_style_namespace_declarations = file_scoped:warning

# Expression bodies for one-line members but not constructors. Stated as one
# block rather than left to inherited defaults, so the policy reads whole.
csharp_style_expression_bodied_methods = true:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_lambdas = true:silent

[*.cs]
# The formatting rule, and the third of the three at warning. IDE0055 is an
# aggregate: it reports every formatting option in this file that a source file
# disagrees with, which is what turns the indent, spacing and single-line
# settings above into build failures rather than editor hints.
#
# It reaches only as far as Roslyn's formatter does. The wrapping rules have no
# engine behind them (see the note above max_line_length), so IDE0055 will not
# break an over-wide list and will not join a ragged one. Those stay a review
# rule; this covers everything else.
dotnet_diagnostic.IDE0055.severity = warning

# Trailing, not leading. A wrapped condition reads as a sequence of lines each
# announcing "and there is more"; the alternative buries that signal at the
# start of the next line, where it also collides with the four-space body
# indent.
dotnet_style_operator_placement_when_wrapping = end_of_line
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_style_prefer_auto_properties = true:silent
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
dotnet_style_prefer_compound_assignment = true:suggestion
dotnet_style_prefer_simplified_interpolation = true:suggestion
dotnet_style_explicit_tuple_names = true:suggestion
dotnet_style_namespace_match_folder = true:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

dotnet_naming_rule.interface_should_be_begins_with_i.severity = suggestion
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.non_field_members_should_be_pascal_case.symbols = non_field_members
dotnet_naming_rule.non_field_members_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum
dotnet_naming_symbols.types.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_symbols.non_field_members.applicable_kinds = property, event, method
dotnet_naming_symbols.non_field_members.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

dotnet_naming_style.pascal_case.capitalization = pascal_case
