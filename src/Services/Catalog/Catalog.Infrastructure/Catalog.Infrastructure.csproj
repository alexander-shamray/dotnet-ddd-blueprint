<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Settings come from Directory.Build.props (§4.4).

    Domain and Application — §4.2's third row permits any package besides, and
    PR-08 is where that row starts being used: EF Core for the write side
    (§7.2), Dapper for the raw writes IUnitOfWork exposes (§6.3), the SQL
    readiness check (§13.5), and IConfiguration, which AddCatalogInfrastructure
    now names in its signature.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Dapper" />
    <!-- SqlConnection, constructed by name in SqlConnectionFactory (§6.5).
         The EF provider above carries it transitively; the direct reference
         states the direct use. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <!-- The bus (§9), PR-13. The transport package; MassTransit itself rides
         in transitively at the same pinned version. No RabbitMQ health-check
         package beside it: AddMassTransit registers the bus check itself,
         argued in Messaging/DependencyInjection.cs. -->
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Catalog.Domain\Catalog.Domain.csproj" />
    <ProjectReference Include="..\Catalog.Application\Catalog.Application.csproj" />
  </ItemGroup>

</Project>
