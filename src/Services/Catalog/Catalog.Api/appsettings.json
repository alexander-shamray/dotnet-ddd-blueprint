{
  // The first appsettings.json in a *service*, and it exists for one reason:
  // §9.7's gRPC hop cannot share a port with §10.2's REST surface, and the
  // per-endpoint protocol is not something an environment variable can say.
  //
  // MEASURED, not assumed. A cleartext Kestrel endpoint at the default
  // Http1AndHttp2 refuses HTTP/2 outright — a client asking for it exactly, as
  // Grpc.Net.Client does, is answered HTTP_1_1_REQUIRED and the connection is
  // closed. ALPN is what negotiates the upgrade and there is no TLS on this
  // hop to carry it (§10.1: TLS terminates at the ingress). So h2c needs an
  // endpoint declared Http2 and nothing else, and an Http2-only endpoint
  // answers an HTTP/1.1 request with a 400 — the two surfaces cannot be one
  // port in either direction.
  //
  // §9.7 printed http://catalog-api:8080 for the client address and was
  // amended in this change to 8081 for exactly this.
  //
  // This section OVERRIDES the container image's own port configuration —
  // also measured, against both spellings: ASPNETCORE_HTTP_PORTS=8080 (what
  // the aspnet image sets) and ASPNETCORE_URLS both lose to Kestrel:Endpoints,
  // and neither produces a warning. So 8080 has to be declared here or it
  // stops existing, and the Compose port mapping and the gateway's own
  // destination would both break on a file that looks like it only added a
  // port.
  "Kestrel": {
    "Endpoints": {
      // §10.2's cluster destination and the health probes. Http1 explicitly
      // rather than by default: the default is Http1AndHttp2, which on
      // cleartext behaves as Http1 anyway, and a reader comparing the two
      // entries below should not have to know that to see which is which.
      "Rest": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      // The BFF's hop, and nothing else reaches it. Not exposed by the gateway
      // (§10.2 routes HTTP), not published by the Compose block, and not a
      // second public surface — it is a cluster-internal port on the same
      // security footing as the SQL one, which is why the RPC on it still
      // authenticates (§11.2).
      "Grpc": {
        "Url": "http://0.0.0.0:8081",
        "Protocols": "Http2"
      }
    }
  }
}
