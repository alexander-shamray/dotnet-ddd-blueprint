<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Settings come from Directory.Build.props (§4.4).

    Microsoft.NET.Sdk with a framework reference, not Microsoft.NET.Sdk.Web:
    this is the library every host references (§4.1), not a host. The Web SDK
    would add an entry point, static web assets and a launch profile to an
    assembly that has none of the three.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- §13.2's AddObservability. Versionless: central package management
         owns the pins (§4.4). The Redis instrumentation is deliberately
         absent and stays so — PR-12 landed it in Common.Infrastructure,
         beside the keyed connections it instruments (§8.2, §13.2). The EF
         Core one arrived here, with PR-08's DbContext. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <!-- ValidationException, caught by ValidationExceptionHandler — §10.5's
         400 row. Common.Application carries the package transitively; the
         direct reference states the direct use. -->
    <PackageReference Include="FluentValidation" />
    <!-- §11.3's AddJwtBearer and TokenValidationParameters. NOT in the shared
         framework: Microsoft.AspNetCore.App carries the authentication
         abstractions and the cookie handler, and every JWT handler since
         ASP.NET Core 3.0 has shipped as this package. The one host package
         Common.Web adds, and the reason is §11.2's — every service
         re-validates, so the registration cannot live in the gateway. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <!-- Result, Error and ErrorType: ToHttpResult maps them to a status
         (§10.5). The first project reference in the repo, and one the
         dependency graph §4.2 draws now actually makes true. -->
    <ProjectReference Include="..\Common.Application\Common.Application.csproj" />
  </ItemGroup>

</Project>
