<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Settings come from Directory.Build.props (§4.4).

    No reference to Common.Domain yet. §4.2 permits one, and TransactionBehavior
    will need it — it counts IAggregateRoot (§6.3) — but that arrives with
    PR-09. An unused project reference is a claim about the dependency graph
    that nothing in this PR makes true.
  -->

  <ItemGroup>
    <!-- IServiceCollection and ILogger<T>. Packages rather than a framework
         reference: §4.2 keeps ASP.NET Core out of Application, and the shared
         framework is how a host would otherwise acquire both. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- The convention scan behind AddPluggableFrom (§6.2). -->
    <PackageReference Include="Scrutor" />
    <!-- ValidationBehavior's IValidator<T> and ValidationException (§6.3). -->
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

</Project>
