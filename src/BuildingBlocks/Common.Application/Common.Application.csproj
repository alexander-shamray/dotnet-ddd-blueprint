<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Settings come from Directory.Build.props (§4.4).

    No reference to Common.Domain yet. §4.2 permits one; nothing here needs one,
    because no type in this assembly names a domain type. An unused project
    reference is a claim about the dependency graph that nothing makes true.

    Not "TransactionBehavior counts IAggregateRoot", which this comment said
    until a review checked it. §6.3's behaviour reads
    IUnitOfWork.ModifiedAggregateCount — an int — and calls
    IDomainEventDispatcher.DispatchAsync(CancellationToken); neither signature
    names a domain type. The `is IAggregateRoot` test lives in EfUnitOfWork,
    over EF's change tracker, and Infrastructure already references Domain.
    That separation is the whole point of counting behind the port.

    The edge is drawn by the first Application type that genuinely names a
    domain type. On the plan that is §7.5's IDomainEventCollector, whose
    CollectAndClear returns IReadOnlyList&lt;IDomainEvent&gt; — so it arrives
    with the outbox, not with PR-09.
  -->

  <ItemGroup>
    <!-- IServiceCollection and ILogger<T>. Packages rather than a framework
         reference: §4.2 keeps ASP.NET Core out of Application, and the shared
         framework is how a host would otherwise acquire both. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- The convention scan behind AddPluggableFrom (§6.2). -->
    <PackageReference Include="Scrutor" />
    <!-- ValidationBehavior's IValidator<T> and ValidationException (§6.3). -->
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

</Project>
