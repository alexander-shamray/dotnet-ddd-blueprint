{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(comm:*)",
      "Grep",
      "Glob",
      "Read"
    ],
    "deny": [
      "Edit(.remember/**)",
      "Edit(./.remember/**)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -m:*)",
      "Bash(git branch -M:*)",
      "Bash(git branch --delete:*)",
      "Bash(git branch --move:*)",
      "Bash(git branch --force:*)"
    ]
  }
}
