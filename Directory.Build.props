<Project>

  <!--
    Shared MSBuild settings for every project in the repository (§4.1). The
    target framework lives here rather than in each csproj because it is a
    platform-wide decision: .NET 10 (LTS) and C# 14, settled in CLAUDE.md and
    not a per-project choice.
  -->
  <PropertyGroup Label="Target">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    The analyser policy of ADR-019. TreatWarningsAsErrors is what makes the
    other two lines mean anything: without it a violation is a message in a
    build log nobody reads, and the log is longest on the pull request that
    introduced the most of them.

    EnforceCodeStyleInBuild promotes the .editorconfig from an editor
    convenience to a build input — but only for rules configured at warning or
    above. Three are, and .editorconfig says which and why. The rest stay
    suggestions deliberately; a style rule with a documented exception it cannot
    express is a rule that must not fail a build.

    latest-Recommended rather than latest-All: the All mode turns on every
    CAxxxx analyser including the documentation and globalisation categories,
    which produce hundreds of diagnostics on a codebase that has made no
    commitment to either.
  -->
  <PropertyGroup Label="Analysis">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>

    <!--
      CA1716 flags a type or member whose name is a reserved word in another
      .NET language, so that a VB or F# consumer does not have to escape it. It
      fires on `Error` (§10.5), and would fire again on any of the short,
      obvious names a domain model reaches for.

      The rule protects a scenario this platform does not have. Nothing here is
      a published library: every project is consumed by C# inside this
      repository, and §4.3 permits exactly one assembly to cross a service
      boundary at all. Renaming `Error` to satisfy a VB caller that will never
      exist would cost the one name the whole error catalogue is written
      around.
    -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <!--
    The one suppression in the repository, and the only place ADR-019 permits
    one: CA1707 forbids underscores in member names, and every test name in §12
    is a sentence written with them — `Cannot_cancel_an_order_that_has_shipped`.
    The two rules are in direct conflict and one of them has to give.

    It is the analyser that gives, because the convention is load-bearing: a
    test name is read in a failure report by someone who is not looking at the
    code, and `CannotCancelAnOrderThatHasShipped` is worse at that job. Scoped
    to test projects by name, so a `_`-laden member in production code still
    fails the build.

    EndsWith('Tests') rather than '.Tests': Platform.IntegrationTests (§12.6)
    ends with the word and not the dotted suffix, and would otherwise be the one
    test project the carve-out missed.
  -->
  <PropertyGroup Label="Test analysis" Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <!--
    Deterministic builds everywhere; path normalisation only on CI, because
    ContinuousIntegrationBuild rewrites source paths in the PDB to be
    repository-relative and that breaks local step-through debugging. The CI
    environment variable is set by GitHub Actions on every runner.
  -->
  <PropertyGroup Label="Build">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
