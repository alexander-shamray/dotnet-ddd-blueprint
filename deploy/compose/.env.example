# Local development only. Every variable has a working default inline in
# docker-compose.yml — copy this file to .env only to override one.
# Variables join this file with the service blocks that read them
# (Appendix C).

# SQL Server sa password, also read by the sql container's healthcheck.
SQL_PASSWORD=Local_Dev_Pa55w0rd!

# Catalog's two §7.1 keys, commented out deliberately: the inline defaults
# nest ${SQL_PASSWORD:-…}, so overriding the password alone keeps both
# connection strings correct — a value uncommented here would freeze the
# password inside it and quietly stop following. Uncomment only to point
# Catalog at a different server or login entirely.
# CATALOG_CONNECTION=Server=sql;Database=Catalog;User Id=sa;Password=Local_Dev_Pa55w0rd!;TrustServerCertificate=True
# CATALOG_MIGRATOR_CONNECTION=Server=sql;Database=Catalog;User Id=sa;Password=Local_Dev_Pa55w0rd!;TrustServerCertificate=True

# Ordering's two §7.1 keys, commented out deliberately: the inline defaults
# nest ${SQL_PASSWORD:-…}, so overriding the password alone keeps both
# connection strings correct — a value uncommented here would freeze the
# password inside it and quietly stop following. Uncomment only to point
# Ordering at a different server or login entirely.
# ORDERING_CONNECTION=Server=sql;Database=Ordering;User Id=sa;Password=Local_Dev_Pa55w0rd!;TrustServerCertificate=True
# ORDERING_MIGRATOR_CONNECTION=Server=sql;Database=Ordering;User Id=sa;Password=Local_Dev_Pa55w0rd!;TrustServerCertificate=True

# The BFF's client secret (§11.5) — the ONE credential set in the platform,
# because the BFF is the one host that calls a peer synchronously (§9.7).
# Commented out deliberately, like the connection strings above: the inline
# default in docker-compose.yml is what makes `docker compose up` work on a
# clean checkout, and it must match the secret in the shipped realm export.
# Uncomment only alongside a realm whose web-bff client carries the new value —
# changing it here alone leaves the host booting and every pricing call
# refused at the token endpoint.
# BFF_CLIENT_SECRET=local-dev-secret
